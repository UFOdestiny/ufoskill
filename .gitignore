# Local editor and assistant state
.vscode/
.idea/
.claude/
.agent/
.codex/
# Keep the Codex marketplace; other local agent state is not distributable.
/.agents/*
!/.agents/plugins/
/.agents/plugins/*
!/.agents/plugins/marketplace.json

# Local environment files (keep documented examples)
.env
.env.*
!.env.example
!.env.*.example
.venv/
venv/

# Python caches and development reports
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Reproducible builds and task outputs
/dist/
/build/
*.egg-info/
/eval-runs/
/ccfa-workfiles/
/logs/
*.log
!tests/fixtures/**/*.log
/tmp/
/temp/

# Editor backups and operating-system files
*.swp
*.swo
*~
*.tmp
*.bak
.DS_Store
Thumbs.db
